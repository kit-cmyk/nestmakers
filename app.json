{
  "expo": {
    "name": "Nestmakers",
    "slug": "nestmakers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "nestmakers",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nestmakers.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF7F1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.nestmakers"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2A1F3D",
          "sounds": []
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nestmakers uses your location to show you profiles nearby."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fce2b773-0301-42e6-b357-326c45e7f910"
      }
    },
    "owner": "kitters25"
  }
}
